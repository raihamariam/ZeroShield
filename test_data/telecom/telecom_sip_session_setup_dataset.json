        "sequence_number": 1,
        "expected_sequence_number": 1,
        "sdp_attributes": [
          [
            "video-configuration",
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          ]
        ],
        "declared_body_length": 32,
        "actual_body_length": 32
      },
      "expected_outcome": "accepted",
      "provenance": "synthetic boundary case: video-configuration SDP attribute value exactly at the assumed maximum (256 characters), expected to remain acceptable; abstracted from CVE-2023-26497 (Samsung Exynos baseband video-configuration attribute memory corruption)",
      "version": "1.0.0"
    },
