      "case_id": "VPN-VALID-001",
      "category": "valid",
      "input_data": {
        "method": "GET",
        "path": "/remote/login",
        "headers": [
          [
            "Host",
            "vpn.example.local"
          ]
        ],
        "declared_content_length": 0,
        "actual_body_length": 0,
        "encoding": "utf-8"
      },
      "expected_outcome": "accepted",
      "provenance": "synthetic baseline valid pre-auth login request with no body",
      "version": "1.0.0"
    },
    {
      "case_id": "VPN-VALID-002",
