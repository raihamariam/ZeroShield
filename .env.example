# Copy to .env and adjust before running `docker compose up` anywhere other than a
# throwaway local/dev machine. Every variable below has a working default baked into
# docker-compose.yml (see the ${VAR:-default} references), so `docker compose up` with
# no .env file at all still works out of the box - this file exists to override those
# defaults, not to be required by them.
#
# None of these are read by the API/worker/web processes themselves outside Docker -
# see docs/CONFIGURATION.md for the full environment variable reference (DATABASE_URL,
# RABBITMQ_URL, MINIO_*, OTEL_EXPORTER_OTLP_ENDPOINT, etc.) used when running natively.

# PostgreSQL password for the `zeroshield` user (run-lifecycle/audit/auth/intelligence
# system of record). Used by the postgres service itself and by api/worker/
# intelligence-worker's DATABASE_URL.
POSTGRES_PASSWORD=zeroshield123

# MinIO root credentials (evidence object storage). Used by the minio service itself
# and by worker/dashboard's MINIO_SECRET_KEY (access key is fixed at "zeroshield").
MINIO_ROOT_PASSWORD=zeroshield123

# Grafana admin password (operational dashboards only - never scientific evidence).
GRAFANA_ADMIN_PASSWORD=zeroshield123

# After `docker compose up -d`, bootstrap the first ADMIN account (required before
# anyone can sign in - V2 Phase 6 local auth has no default/seeded user):
#   docker compose exec api zeroshield create-admin --username <you> --password "<a strong password>"
