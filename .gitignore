.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Generated run outputs (directory structure is tracked via .gitkeep; contents are not)
results/*
!results/.gitkeep
overleaf_exports/*
!overleaf_exports/.gitkeep
jobs/*
!jobs/.gitkeep

# Local editor/agent tooling (machine-local, not project source)
.claude/
.agents/
commands.txt

# Real local environment files - .env.example is the only env file meant to
# be tracked; anything without the .example suffix is assumed to carry real
# local secrets (POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD, GRAFANA_ADMIN_PASSWORD,
# GEMINI_API_KEY, ...).
.env
.env.*
!.env.example

# Reference/planning documents kept locally only, not published on GitHub
docs/
*.docx
*.pdf
*.xlsx
srs_full_text.txt
srs_image*.png
