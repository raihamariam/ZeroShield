{
  "test_set_id": "telecom-sip-session-setup-v1",
  "version": "1.0.0",
  "domain": "TELECOM",
  "cases": [
    {
      "case_id": "TEL-VALID-001",
      "category": "valid",
      "input_data": {
        "method": "INVITE",
        "session_state": "INIT",
        "headers": [
          [
            "Call-ID",
            "call-0001"
          ],
          [
            "From",
            "sip:alice@ims.example.local"
          ],
          [
            "To",
            "sip:bob@ims.example.local"
          ]
        ],
        "sequence_number": 1,
        "expected_sequence_number": 1,
        "sdp_attributes": [
          [
            "accept-type",
            "audio/AMR"
          ]
        ],
        "declared_body_length": 32,
        "actual_body_length": 32
      },
      "expected_outcome": "accepted",
      "provenance": "synthetic valid session-setup INVITE at INIT state with well-formed headers and SDP",
      "version": "1.0.0"
    },
    {
      "case_id": "TEL-VALID-002",
