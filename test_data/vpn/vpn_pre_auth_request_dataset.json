        "declared_content_length": 42,
        "actual_body_length": 42,
        "encoding": "utf-8"
      },
      "expected_outcome": "accepted",
      "provenance": "synthetic valid pre-auth login POST with consistent declared/actual body length",
      "version": "1.0.0"
    },
