.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Generated run outputs (directory structure is tracked via .gitkeep; contents are not)
results/*
!results/.gitkeep
overleaf_exports/*
!overleaf_exports/.gitkeep
jobs/*
!jobs/.gitkeep

# Local Claude Code tooling (session-local, not project source)
.claude/
.agents/
commands.txt

# Real local environment files (final release verification fix) - .env.example
# is the only env file meant to be tracked; anything without the .example
# suffix is assumed to carry real local secrets (POSTGRES_PASSWORD,
# MINIO_ROOT_PASSWORD, GRAFANA_ADMIN_PASSWORD, ANTHROPIC_API_KEY, ...).
.env
.env.*
!.env.example
